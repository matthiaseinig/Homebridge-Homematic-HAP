#!/usr/bin/env bash
# Auto-bump the patch version on every commit so users on a
# `npm install /local/path` deploy workflow actually pick up changes
# (npm skips re-install when the version hasn't moved).
#
# Enable once per clone with:
#     git config core.hooksPath .githooks
#
# Skip the bump for the bump itself (avoids infinite-loop on rebases
# that touch only package.json) by checking whether the only staged
# change is package.json's version line.

set -e

# If we're in the middle of a merge/rebase/cherry-pick, don't touch
# the version — the user/operator is mid-flight.
if [ -f .git/MERGE_HEAD ] || [ -f .git/rebase-merge ] || [ -f .git/rebase-apply ] || [ -f .git/CHERRY_PICK_HEAD ]; then
  exit 0
fi

# If the staged change is exclusively the version field of package.json,
# don't double-bump.
staged_files=$(git diff --cached --name-only)
if [ "$staged_files" = "package.json" ] || [ "$staged_files" = "package.json
package-lock.json" ]; then
  staged_diff=$(git diff --cached -- package.json)
  if echo "$staged_diff" | grep -E '^[+-]' | grep -vE '^(\+\+\+|---)' | grep -vE '^[+-].*"version"' >/dev/null 2>&1; then
    : # there are non-version changes, proceed with bump
  else
    exit 0
  fi
fi

# Bump the patch version without tagging or auto-committing.
npm version patch --no-git-tag-version --allow-same-version >/dev/null

# Re-stage the bumped files so the new version is in the same commit.
git add package.json
[ -f package-lock.json ] && git add package-lock.json

exit 0
