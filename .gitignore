# Build output
# (dist/ is intentionally tracked while the plugin isn't on npm yet, so
# `npm install -g matthiaseinig/Homebridge-Homematic-HAP` works as a
# one-liner without a build step. Once we publish to npm, this will go
# back to /dist/.)
*.tsbuildinfo

# Dependencies
node_modules/

# Test coverage
coverage/
*.lcov

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env / secrets — defense in depth even though we don't use any
.env
.env.local
.env.*.local

# Local Homebridge dev sandbox
test/hbConfig/persist/
test/hbConfig/accessories/
test/hbConfig/.uix-secrets

# References (cloned reference repos used for analysis only — not part of this plugin)
references/
target/

# Package manager
.npm
.pnp.*

# Optional outputs we don't ship
*.tgz
*.tar.gz

# Never commit hap-homematic backups (they may contain device serials,
# variable names, room layouts, even pairing material) or any
# credential file the developer might have used during testing.
hap-homematic-backup*
ccu-credentials*
*.creds
.ccu-probe.*
